rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    // ============ Helpers ============

    function email() {
      return request.auth.token.email.lower();
    }

    function getRole(em) {
      return exists(/databases/$(database)/documents/users/$(em))
        ? get(/databases/$(database)/documents/users/$(em)).data.role
        : 'user';
    }

    function roleOf() {
      return getRole(email());
    }


    // ============ messages (chat) ============
    // CHAT FIX: READ is signedIn.
    // The message-level `participants` gate broke chat — in support chat
    // every message's participants are {staff, sender}, so when staff
    // replied, that message carried no client email and the client
    // never saw the reply (only their own messages).
    // The write gates below are strict: only the channel's allowed user can write.
    match /messages/{messageId} {
      allow read: if request.auth != null;

      // CREATE: sender + participants + channel gate
      allow create: if request.auth != null
        && request.resource.data.senderEmail is string
        && request.resource.data.senderEmail.lower() == email()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 1
        && request.resource.data.participants.size() <= 40
        && email() in request.resource.data.participants
        && (request.resource.data.channel == 'support'
            || (request.resource.data.channel == 'admin'
                && (roleOf() == 'superAdmin' || roleOf() == 'subAdmin'))
            || (request.resource.data.channel == 'subadmins'
                && roleOf() == 'subAdmin')
            // Team chat: member, team owner ya CEO
            || (request.resource.data.channel.startsWith('team:')
                && (exists(/databases/$(database)/documents/sub_teams/
                      $(request.resource.data.channel.substring(5, request.resource.data.channel.size()))/members/$(email()))
                    || request.resource.data.channel.substring(5, request.resource.data.channel.size()).lower() == email()
                    || roleOf() == 'superAdmin'))
            // Request chat: request owner, assigned subAdmin ya CEO
            || (request.resource.data.channel.startsWith('request:')
                && exists(/databases/$(database)/documents/requests/
                    $(request.resource.data.channel.substring(8, request.resource.data.channel.size())))
                && (roleOf() == 'superAdmin'
                    || (get(/databases/$(database)/documents/requests/
                        $(request.resource.data.channel.substring(8, request.resource.data.channel.size()))).data.userEmail is string
                        && get(/databases/$(database)/documents/requests/
                            $(request.resource.data.channel.substring(8, request.resource.data.channel.size()))).data.userEmail.lower() == email())
                    || (get(/databases/$(database)/documents/requests/
                        $(request.resource.data.channel.substring(8, request.resource.data.channel.size()))).data.assignedTo is string
                        && get(/databases/$(database)/documents/requests/
                            $(request.resource.data.channel.substring(8, request.resource.data.channel.size()))).data.assignedTo.lower() == email()))));

      // UPDATE: for the legacy backfill — the CEO may only change the
      // `participants` field (ChatRepository.migrateLegacyParticipants).
      allow update: if request.auth != null
        && roleOf() == 'superAdmin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']);

      allow delete: if request.auth != null
        && (resource.data.senderEmail == email() || roleOf() == 'superAdmin');
    }


    // ============ requests ============
    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userEmail == email()
        && request.resource.data.id == requestId
        && request.resource.data.status == 'pending'
        && request.resource.data.assignedTo == ''
        && request.resource.data.assignedByName == ''
        && request.resource.data.category in ['complaint', 'inspection', 'panelWashing']
        && request.resource.data.priority in ['Normal', 'Urgent']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && (!('address' in request.resource.data)
            || (request.resource.data.address is string
                && request.resource.data.address.size() <= 500))
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string
                && request.resource.data.phone.size() <= 20))
        && request.resource.data.keys().hasOnly(['id', 'userEmail', 'userName',
            'category', 'subCategory', 'priority', 'description', 'status',
            'createdAt', 'assignedTo', 'assignedByName', 'address', 'phone']);
      allow update: if request.auth != null
        && (roleOf() == 'superAdmin'
            || (resource.data.userEmail == email()
                && !('rating' in resource.data)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'review', 'ratedAt']))
            || (roleOf() == 'subAdmin' && resource.data.assignedTo == email()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      allow delete: if request.auth != null
        && (resource.data.userEmail == email() || roleOf() == 'superAdmin');
    }


    // ============ users ============
    match /users/{userEmail} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && ((request.resource.data.email == email() && request.resource.data.role == 'user')
            || (roleOf() == 'superAdmin' && request.resource.data.role in ['user', 'subAdmin'])
            || (roleOf() == 'subAdmin' && request.resource.data.role == 'user')
            || (roleOf() == 'superAdmin' && request.resource.data.email == email()));
      allow update: if request.auth != null
        && ((request.resource.data.email == email() && request.resource.data.role == roleOf())
            || (roleOf() == 'superAdmin' && request.resource.data.role in ['user', 'subAdmin'])
            || (roleOf() == 'subAdmin' && request.resource.data.role == 'user')
            || (roleOf() == 'superAdmin' && request.resource.data.email == email()));
      allow delete: if request.auth != null
        && (resource.data.email == email() || roleOf() == 'superAdmin');
    }


    // ============ notifications ============
    match /notifications/{notifId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 500
        && (roleOf() == 'superAdmin'
            || request.resource.data.forEmail == email());
      allow update: if request.auth != null
        && (resource.data.forEmail == email() || resource.data.forEmail == '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if roleOf() == 'superAdmin' || resource.data.forEmail == email();
    }


    // ============ profiles ============
    match /profiles/{profileEmail} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && profileEmail == email();
      allow update: if request.auth != null && profileEmail == email();
      allow delete: if roleOf() == 'superAdmin' || profileEmail == email();
    }


    // ============ team (Sub Admins) ============
    match /team/{memberEmail} {
      allow read: if request.auth != null;
      allow create: if roleOf() == 'superAdmin'
        && !exists(/databases/$(database)/documents/team/$(memberEmail));
      allow delete: if roleOf() == 'superAdmin'
        || memberEmail == email();
    }


    // ============ sub_teams ============
    match /sub_teams/{subAdminEmail} {
      allow read: if request.auth != null;
      allow delete: if roleOf() == 'superAdmin'
        || subAdminEmail == email();
    }

    // Specific match for create/delete (the subAdminEmail path variable is needed).
    match /sub_teams/{subAdminEmail}/members/{memberEmail} {
      allow create: if (roleOf() == 'superAdmin'
          || subAdminEmail == email())
        && !exists(/databases/$(database)/documents/sub_teams/$(subAdminEmail)/members/$(memberEmail));
      allow delete: if roleOf() == 'superAdmin'
        || subAdminEmail == email() || memberEmail == email();
    }

    // Recursive match: collectionGroup('members') queries
    match /{path=**}/members/{memberEmail} {
      allow read: if request.auth != null;
    }


    // ============ config ============
    match /config/{docId} {
      allow read: if docId == 'settings' || request.auth != null;
      allow write: if roleOf() == 'superAdmin';
    }
  }
}
