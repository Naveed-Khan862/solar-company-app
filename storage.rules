// MFES — Firebase Storage Security Rules
// =====================================================
// NOTE: Paste this into Firebase Console → Storage → Rules and DEPLOY it.
//
// Fix #9: profile photos — only the owner can upload/delete their own photo;
// any signed-in user can view the photos (avatars).
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos: profile_photos/{email}.jpg
    match /profile_photos/{email}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && email == request.auth.token.email;
      allow delete: if request.auth != null && email == request.auth.token.email;
    }
  }
}
